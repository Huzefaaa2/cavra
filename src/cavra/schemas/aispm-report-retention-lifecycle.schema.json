{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Retention Lifecycle Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "policy",
    "report_lifecycle",
    "audit_export_lifecycle",
    "deletion_policy",
    "evidence",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_retention_lifecycle.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": [
        "policy_id",
        "default_retention_days",
        "audit_event_retention_days",
        "immutable_storage_required",
        "legal_hold_supported",
        "deletion_requires_approval"
      ],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "default_retention_days": { "type": "integer", "minimum": 1 },
        "audit_event_retention_days": { "type": "integer", "minimum": 1 },
        "immutable_storage_required": { "type": "boolean" },
        "legal_hold_supported": { "type": "boolean" },
        "deletion_requires_approval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "report_lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "report_ref",
          "report_id",
          "created_at",
          "expires_at",
          "lifecycle_state",
          "immutable_store_ref",
          "legal_hold_ref"
        ],
        "properties": {
          "report_ref": { "type": "string", "minLength": 1 },
          "report_id": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "lifecycle_state": {
            "enum": ["retained", "archived", "expired", "legal_hold", "pending_approval", "deleted"]
          },
          "immutable_store_ref": { "type": "string", "minLength": 1 },
          "legal_hold_ref": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "audit_export_lifecycle": {
      "type": "object",
      "required": [
        "export_ref",
        "created_at",
        "expires_at",
        "archive_state",
        "object_lock",
        "kms_key_ref"
      ],
      "properties": {
        "export_ref": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "archive_state": { "enum": ["pending", "archived", "expired", "legal_hold", "failed"] },
        "object_lock": { "enum": ["enabled", "disabled", "requires_cavra_enterprise"] },
        "kms_key_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "deletion_policy": {
      "type": "object",
      "required": ["allowed_states", "blocked_states", "approval_required", "tombstone_required"],
      "properties": {
        "allowed_states": {
          "type": "array",
          "items": { "enum": ["expired", "archived", "deleted"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "blocked_states": {
          "type": "array",
          "items": { "enum": ["retained", "legal_hold", "pending_approval"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "approval_required": { "type": "boolean" },
        "tombstone_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["retention_evidence_refs", "archive_manifest_ref", "chain_ref"],
      "properties": {
        "retention_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "archive_manifest_ref": { "type": "string", "minLength": 1 },
        "chain_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "raw_report_content_included",
        "recipient_addresses_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "raw_report_content_included": { "const": false },
        "recipient_addresses_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "enum": ["metadata_only", "redacted_summary", "private_payload_ref"] }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "retention_worker",
        "legal_hold_store",
        "immutable_archive",
        "kms_integration",
        "deletion_approval_workflow",
        "license_enforcement"
      ],
      "properties": {
        "retention_worker": { "const": "requires_cavra_enterprise" },
        "legal_hold_store": { "const": "requires_cavra_enterprise" },
        "immutable_archive": { "const": "requires_cavra_enterprise" },
        "kms_integration": { "const": "requires_cavra_enterprise" },
        "deletion_approval_workflow": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
