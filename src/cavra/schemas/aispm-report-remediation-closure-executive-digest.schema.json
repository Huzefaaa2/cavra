{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Remediation Closure Executive Digest Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "digest",
    "executive_summary",
    "metrics",
    "risk_summary",
    "remediation_status",
    "board_talking_points",
    "audit_readiness",
    "distribution",
    "evidence",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "cavra.aispm.report_remediation_closure_executive_digest.v1"
    },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "digest": {
      "type": "object",
      "required": [
        "digest_ref",
        "title",
        "period",
        "audiences",
        "status",
        "prepared_at",
        "visibility"
      ],
      "properties": {
        "digest_ref": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cso", "ciso", "board", "audit", "grc"] }
        },
        "status": { "enum": ["ready", "attention_required", "blocked"] },
        "prepared_at": { "type": "string", "format": "date-time" },
        "visibility": { "const": "public_safe_metadata" }
      },
      "additionalProperties": false
    },
    "executive_summary": {
      "type": "object",
      "required": [
        "headline",
        "closure_readiness",
        "key_message",
        "material_risk",
        "recommended_action"
      ],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "closure_readiness": { "enum": ["ready", "attention_required", "blocked"] },
        "key_message": { "type": "string", "minLength": 1 },
        "material_risk": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "closed_plans",
        "open_plans",
        "overdue_closures",
        "overdue_tasks",
        "closure_rate",
        "sla_breached_count",
        "residual_risk_acceptances",
        "overdue_residual_risk_reviews",
        "post_incident_review_completion_rate"
      ],
      "properties": {
        "closed_plans": { "type": "integer", "minimum": 0 },
        "open_plans": { "type": "integer", "minimum": 0 },
        "overdue_closures": { "type": "integer", "minimum": 0 },
        "overdue_tasks": { "type": "integer", "minimum": 0 },
        "closure_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "sla_breached_count": { "type": "integer", "minimum": 0 },
        "residual_risk_acceptances": { "type": "integer", "minimum": 0 },
        "overdue_residual_risk_reviews": { "type": "integer", "minimum": 0 },
        "post_incident_review_completion_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "risk_summary": {
      "type": "object",
      "required": [
        "residual_risk_level",
        "high_or_critical_residual_risk_count",
        "top_risk_themes",
        "accepted_risk_review_due_at"
      ],
      "properties": {
        "residual_risk_level": { "enum": ["none", "low", "medium", "high", "critical"] },
        "high_or_critical_residual_risk_count": { "type": "integer", "minimum": 0 },
        "top_risk_themes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "accepted_risk_review_due_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "remediation_status": {
      "type": "object",
      "required": [
        "closure_approval_queue",
        "residual_risk_review_queue",
        "post_incident_review_queue",
        "evidence_finalization_queue",
        "closure_slo_status"
      ],
      "properties": {
        "closure_approval_queue": { "enum": ["healthy", "degraded", "breached"] },
        "residual_risk_review_queue": { "enum": ["healthy", "degraded", "breached"] },
        "post_incident_review_queue": { "enum": ["healthy", "degraded", "breached"] },
        "evidence_finalization_queue": { "enum": ["healthy", "degraded", "breached"] },
        "closure_slo_status": { "enum": ["healthy", "degraded", "breached"] }
      },
      "additionalProperties": false
    },
    "board_talking_points": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "audit_readiness": {
      "type": "object",
      "required": [
        "auditor_ready",
        "immutable_evidence_available",
        "exceptions_count",
        "report_package_refs",
        "evidence_refs"
      ],
      "properties": {
        "auditor_ready": { "type": "boolean" },
        "immutable_evidence_available": { "type": "boolean" },
        "exceptions_count": { "type": "integer", "minimum": 0 },
        "report_package_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": [
        "formats",
        "delivery_modes",
        "approval_required",
        "recipient_policy_ref"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["pdf", "docx", "html", "signed_json"] }
        },
        "delivery_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["portal", "email", "grc_upload"] }
        },
        "approval_required": { "type": "boolean" },
        "recipient_policy_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "digest_ref",
        "operations_dashboard_ref",
        "latest_closure_ref",
        "immutable_store_ref",
        "evidence_refs"
      ],
      "properties": {
        "digest_ref": { "type": "string", "minLength": 1 },
        "operations_dashboard_ref": { "type": "string", "minLength": 1 },
        "latest_closure_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "derived_from_closure_operations",
        "rbac_scoped",
        "executive_approval_required",
        "immutable_digest_required",
        "recipient_policy_enforced",
        "raw_payloads_excluded"
      ],
      "properties": {
        "derived_from_closure_operations": { "type": "boolean" },
        "rbac_scoped": { "type": "boolean" },
        "executive_approval_required": { "type": "boolean" },
        "immutable_digest_required": { "type": "boolean" },
        "recipient_policy_enforced": { "type": "boolean" },
        "raw_payloads_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "operator_identity_included",
        "auditor_identity_included",
        "approver_identity_included",
        "ip_address_included",
        "download_urls_included",
        "raw_report_content_included",
        "provider_response_included",
        "customer_records_included",
        "private_remediation_details_included",
        "tenant_drilldown_records_included",
        "board_member_identity_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "operator_identity_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "provider_response_included": { "const": false },
        "customer_records_included": { "const": false },
        "private_remediation_details_included": { "const": false },
        "tenant_drilldown_records_included": { "const": false },
        "board_member_identity_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": {
          "const": "remediation_closure_executive_digest_metadata_only"
        }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "digest_renderer",
        "board_pack_renderer",
        "tenant_metrics_store",
        "report_delivery",
        "approval_workflow",
        "evidence_package_builder",
        "license_enforcement"
      ],
      "properties": {
        "digest_renderer": { "const": "requires_cavra_enterprise" },
        "board_pack_renderer": { "const": "requires_cavra_enterprise" },
        "tenant_metrics_store": { "const": "requires_cavra_enterprise" },
        "report_delivery": { "const": "requires_cavra_enterprise" },
        "approval_workflow": { "const": "requires_cavra_enterprise" },
        "evidence_package_builder": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
