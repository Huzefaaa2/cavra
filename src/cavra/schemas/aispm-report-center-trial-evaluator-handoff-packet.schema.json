{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cavra.dev/schemas/aispm-report-center-trial-evaluator-handoff-packet.schema.json",
  "title": "CAVRA AISPM Report Center Trial Evaluator Handoff Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "handoff_ref",
    "trial_ref",
    "tenant_ref",
    "source_contract_refs",
    "evaluator_experience",
    "package_access",
    "license_status",
    "support",
    "revocation",
    "onboarding_checks",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "cavra.aispm.report_center_trial_evaluator_handoff_packet.v1"
    },
    "product": {
      "const": "CAVRA"
    },
    "edition": {
      "const": "enterprise_trial"
    },
    "contract_visibility": {
      "const": "public_contract"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "handoff_ref": {
      "type": "string",
      "pattern": "^handoff:"
    },
    "trial_ref": {
      "type": "string",
      "pattern": "^trial:"
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tenant:"
    },
    "source_contract_refs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluator_experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "welcome_title",
        "audience",
        "estimated_setup_minutes",
        "instructions_ref",
        "steps"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["pending_operator_approval", "ready_for_evaluator", "revoked", "expired"]
        },
        "welcome_title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["security_leader", "platform_engineer", "ai_governance_reviewer"]
          }
        },
        "estimated_setup_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "instructions_ref": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "title", "status", "requires_operator", "evidence_ref"],
            "properties": {
              "step_id": {
                "type": "string",
                "enum": [
                  "confirm-approval",
                  "authenticate-package-registry",
                  "pull-trial-package",
                  "configure-license",
                  "run-first-validation"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": ["pending", "ready", "complete", "blocked"]
              },
              "requires_operator": {
                "type": "boolean"
              },
              "evidence_ref": {
                "type": "string",
                "pattern": "^cavra://evidence/redacted/"
              }
            }
          }
        }
      }
    },
    "package_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "package_ref",
        "access_status",
        "permissions_required",
        "image_ref_redacted",
        "download_urls_included",
        "package_token_included",
        "access_expires_at"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["ghcr", "private_registry"]
        },
        "package_ref": {
          "type": "string",
          "pattern": "^package:"
        },
        "access_status": {
          "type": "string",
          "enum": ["pending", "ready", "revoked", "expired"]
        },
        "permissions_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["read:packages"]
          }
        },
        "image_ref_redacted": {
          "const": true
        },
        "download_urls_included": {
          "const": false
        },
        "package_token_included": {
          "const": false
        },
        "access_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "license_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_ref",
        "status",
        "license_type",
        "issued_at",
        "expires_at",
        "revocation_state",
        "license_key_included"
      ],
      "properties": {
        "license_ref": {
          "type": "string",
          "pattern": "^license:"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "expired", "revoked"]
        },
        "license_type": {
          "const": "trial"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_state": {
          "type": "string",
          "enum": ["not_revoked", "revocation_requested", "revoked"]
        },
        "license_key_included": {
          "const": false
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_state", "channels", "response_slo", "support_ticket_ref"],
      "properties": {
        "support_state": {
          "type": "string",
          "enum": ["operator_review_pending", "available", "closed"]
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "label", "status", "contact_detail_included"],
            "properties": {
              "channel_id": {
                "type": "string",
                "enum": ["trial-portal", "email"]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": ["available", "unavailable"]
              },
              "contact_detail_included": {
                "const": false
              }
            }
          }
        },
        "response_slo": {
          "type": "string",
          "enum": ["next_business_day", "best_effort"]
        },
        "support_ticket_ref": {
          "type": "string",
          "pattern": "^support:"
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revocation_supported",
        "current_state",
        "revocation_ref",
        "blocked_after_revocation",
        "audit_event_required"
      ],
      "properties": {
        "revocation_supported": { "const": true },
        "current_state": {
          "type": "string",
          "enum": ["not_revoked", "revocation_requested", "revoked"]
        },
        "revocation_ref": {
          "type": "string",
          "pattern": "^revocation:"
        },
        "blocked_after_revocation": { "const": true },
        "audit_event_required": { "const": true }
      }
    },
    "onboarding_checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "evidence_ref"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "operator_approved",
              "package_access_ready",
              "license_active",
              "validation_packet_available"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "passed", "failed"]
          },
          "evidence_ref": {
            "type": "string",
            "pattern": "^cavra://evidence/redacted/"
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_approval_required",
        "trial_license_required",
        "package_access_gated",
        "revocation_enforced",
        "support_handoff_audited",
        "evidence_refs_only",
        "raw_payloads_excluded"
      ],
      "properties": {
        "operator_approval_required": { "const": true },
        "trial_license_required": { "const": true },
        "package_access_gated": { "const": true },
        "revocation_enforced": { "const": true },
        "support_handoff_audited": { "const": true },
        "evidence_refs_only": { "const": true },
        "raw_payloads_excluded": { "const": true }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_addresses_included",
        "operator_identity_included",
        "evaluator_identity_included",
        "auditor_identity_included",
        "approver_identity_included",
        "board_member_identity_included",
        "ip_address_included",
        "download_urls_included",
        "package_tokens_included",
        "license_key_included",
        "raw_prompt_included",
        "model_reasoning_included",
        "raw_tool_output_included",
        "raw_report_content_included",
        "provider_response_included",
        "customer_records_included",
        "private_remediation_details_included",
        "tenant_drilldown_records_included",
        "secrets_included",
        "source_code_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "operator_identity_included": { "const": false },
        "evaluator_identity_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "board_member_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "package_tokens_included": { "const": false },
        "license_key_included": { "const": false },
        "raw_prompt_included": { "const": false },
        "model_reasoning_included": { "const": false },
        "raw_tool_output_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "provider_response_included": { "const": false },
        "customer_records_included": { "const": false },
        "private_remediation_details_included": { "const": false },
        "tenant_drilldown_records_included": { "const": false },
        "secrets_included": { "const": false },
        "source_code_included": { "const": false },
        "payload_handling": {
          "const": "report_center_trial_evaluator_handoff_metadata_only"
        }
      }
    },
    "enterprise_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_portal",
        "package_access_service",
        "license_service",
        "revocation_service",
        "support_queue",
        "audit_store"
      ],
      "properties": {
        "trial_portal": { "const": "requires_cavra_enterprise" },
        "package_access_service": { "const": "requires_cavra_enterprise" },
        "license_service": { "const": "requires_cavra_enterprise" },
        "revocation_service": { "const": "requires_cavra_enterprise" },
        "support_queue": { "const": "requires_cavra_enterprise" },
        "audit_store": { "const": "requires_cavra_enterprise" }
      }
    }
  }
}
