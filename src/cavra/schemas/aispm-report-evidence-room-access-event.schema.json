{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Evidence Room Access Event Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "event",
    "actor",
    "access_decision",
    "artifacts",
    "controls",
    "integrity",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_evidence_room_access_event.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "event": {
      "type": "object",
      "required": [
        "event_ref",
        "room_ref",
        "event_type",
        "outcome",
        "occurred_at",
        "source",
        "correlation_ref"
      ],
      "properties": {
        "event_ref": { "type": "string", "minLength": 1 },
        "room_ref": { "type": "string", "minLength": 1 },
        "event_type": {
          "enum": ["view", "download", "revoke", "expire", "failed_auth", "failed_policy", "watermark"]
        },
        "outcome": { "enum": ["allowed", "blocked", "revoked", "expired", "failed", "logged"] },
        "occurred_at": { "type": "string", "format": "date-time" },
        "source": {
          "enum": ["evidence_room_portal", "download_service", "revocation_worker", "scheduler", "api"]
        },
        "correlation_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": [
        "actor_ref",
        "actor_type",
        "identity_redacted",
        "organization_ref",
        "mfa_verified",
        "ip_address_redacted"
      ],
      "properties": {
        "actor_ref": { "type": "string", "minLength": 1 },
        "actor_type": {
          "enum": ["external_auditor", "internal_auditor", "grc_admin", "cso", "system"]
        },
        "identity_redacted": { "const": true },
        "organization_ref": { "type": "string", "minLength": 1 },
        "mfa_verified": { "type": "boolean" },
        "ip_address_redacted": { "const": true }
      },
      "additionalProperties": false
    },
    "access_decision": {
      "type": "object",
      "required": ["decision", "reason", "policy_refs", "expires_at", "revocation_ref"],
      "properties": {
        "decision": { "enum": ["allow", "block", "revoke", "expire"] },
        "reason": { "type": "string", "minLength": 1 },
        "policy_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "revocation_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_ref", "report_id", "format", "digest_ref", "watermark_applied"],
        "properties": {
          "artifact_ref": { "type": "string", "minLength": 1 },
          "report_id": { "type": "string", "minLength": 1 },
          "format": {
            "enum": ["markdown", "json", "csv", "pdf", "xlsx", "docx", "html", "jsonl", "zip"]
          },
          "digest_ref": { "type": "string", "minLength": 1 },
          "watermark_applied": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "signed_link_used",
        "watermark_required",
        "access_logged",
        "immutable_audit_required",
        "retention_checked",
        "license_checked"
      ],
      "properties": {
        "signed_link_used": { "type": "boolean" },
        "watermark_required": { "type": "boolean" },
        "access_logged": { "type": "boolean" },
        "immutable_audit_required": { "type": "boolean" },
        "retention_checked": { "type": "boolean" },
        "license_checked": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "event_digest_ref",
        "previous_event_digest_ref",
        "manifest_ref",
        "audit_store_ref",
        "evidence_refs"
      ],
      "properties": {
        "event_digest_ref": { "type": "string", "minLength": 1 },
        "previous_event_digest_ref": { "type": ["string", "null"] },
        "manifest_ref": { "type": "string", "minLength": 1 },
        "audit_store_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "auditor_identity_included",
        "ip_address_included",
        "download_urls_included",
        "raw_report_content_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "const": "metadata_only" }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "identity_resolution",
        "signed_download_links",
        "watermarking_service",
        "immutable_access_event_store",
        "revocation_workflow",
        "license_enforcement"
      ],
      "properties": {
        "identity_resolution": { "const": "requires_cavra_enterprise" },
        "signed_download_links": { "const": "requires_cavra_enterprise" },
        "watermarking_service": { "const": "requires_cavra_enterprise" },
        "immutable_access_event_store": { "const": "requires_cavra_enterprise" },
        "revocation_workflow": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
