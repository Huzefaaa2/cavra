{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA Policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "description", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^cavra-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "inherits": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
          ]
        },
        "mode": {"enum": ["audit_only", "enforce", "strict_regulated", "break_glass"]}
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_read": {"$ref": "#/$defs/stringList"},
        "block_write": {"$ref": "#/$defs/stringList"},
        "require_approval_write": {"$ref": "#/$defs/stringList"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": {"$ref": "#/$defs/stringList"},
        "allow": {"$ref": "#/$defs/stringList"},
        "require_approval": {"$ref": "#/$defs/stringList"}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "require_pull_request": {"type": "boolean"},
        "block_direct_push_to_protected_branch": {"type": "boolean"},
        "require_human_reviewer": {"type": "boolean"},
        "require_ai_attestation": {"type": "boolean"}
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowlist_enabled": {"type": "boolean"},
        "block_unknown_servers": {"type": "boolean"},
        "allowed_servers": {"$ref": "#/$defs/stringList"},
        "blocked_servers": {"$ref": "#/$defs/stringList"},
        "risk_scoring": {
          "type": "object",
          "additionalProperties": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maps_to": {"$ref": "#/$defs/stringList"}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
