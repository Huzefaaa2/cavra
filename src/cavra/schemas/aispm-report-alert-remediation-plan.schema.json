{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Alert Remediation Plan Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "plan",
    "scope",
    "tasks",
    "approval_requirements",
    "closure_criteria",
    "control_updates",
    "communications",
    "evidence",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_alert_remediation_plan.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "plan": {
      "type": "object",
      "required": [
        "plan_ref",
        "status",
        "priority",
        "owner_role",
        "opened_at",
        "due_at",
        "source_alert_ref",
        "source_incident_ref"
      ],
      "properties": {
        "plan_ref": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "in_progress", "blocked", "completed", "closed"] },
        "priority": { "enum": ["low", "medium", "high", "critical"] },
        "owner_role": { "type": "string", "minLength": 1 },
        "opened_at": { "type": "string", "format": "date-time" },
        "due_at": { "type": "string", "format": "date-time" },
        "source_alert_ref": { "type": "string", "minLength": 1 },
        "source_incident_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "finding_type",
        "affected_report_refs",
        "affected_evidence_room_refs",
        "affected_integration_refs",
        "customer_records_redacted"
      ],
      "properties": {
        "finding_type": { "type": "string", "minLength": 1 },
        "affected_report_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affected_evidence_room_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affected_integration_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "customer_records_redacted": { "const": true }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_ref",
          "title",
          "owner_role",
          "status",
          "due_at",
          "approval_required",
          "evidence_required",
          "evidence_ref"
        ],
        "properties": {
          "task_ref": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "in_progress", "blocked", "completed", "cancelled"] },
          "due_at": { "type": "string", "format": "date-time" },
          "approval_required": { "type": "boolean" },
          "evidence_required": { "type": "boolean" },
          "evidence_ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approval_ref", "approval_type", "approver_role", "status", "due_at"],
        "properties": {
          "approval_ref": { "type": "string", "minLength": 1 },
          "approval_type": { "type": "string", "minLength": 1 },
          "approver_role": { "type": "string", "minLength": 1 },
          "status": { "enum": ["not_requested", "pending", "approved", "denied", "expired"] },
          "due_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "closure_criteria": {
      "type": "object",
      "required": [
        "all_tasks_complete",
        "required_approvals_complete",
        "evidence_chain_complete",
        "incident_closure_required",
        "post_incident_review_required"
      ],
      "properties": {
        "all_tasks_complete": { "type": "boolean" },
        "required_approvals_complete": { "type": "boolean" },
        "evidence_chain_complete": { "type": "boolean" },
        "incident_closure_required": { "type": "boolean" },
        "post_incident_review_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "control_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_ref", "update_type", "owner_role", "status", "evidence_ref"],
        "properties": {
          "control_ref": { "type": "string", "minLength": 1 },
          "update_type": { "type": "string", "minLength": 1 },
          "owner_role": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "in_progress", "completed", "cancelled"] },
          "evidence_ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "communications": {
      "type": "object",
      "required": [
        "internal_update_required",
        "executive_update_required",
        "customer_notification_required",
        "external_message_ref"
      ],
      "properties": {
        "internal_update_required": { "type": "boolean" },
        "executive_update_required": { "type": "boolean" },
        "customer_notification_required": { "type": "boolean" },
        "external_message_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "plan_digest_ref",
        "alert_drilldown_ref",
        "incident_packet_ref",
        "closure_manifest_ref",
        "immutable_store_ref",
        "evidence_refs"
      ],
      "properties": {
        "plan_digest_ref": { "type": "string", "minLength": 1 },
        "alert_drilldown_ref": { "type": "string", "minLength": 1 },
        "incident_packet_ref": { "type": "string", "minLength": 1 },
        "closure_manifest_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "task_owners_required",
        "approval_gates_enforced",
        "closure_criteria_required",
        "post_incident_control_updates_required",
        "immutable_plan_required",
        "raw_payloads_excluded"
      ],
      "properties": {
        "task_owners_required": { "type": "boolean" },
        "approval_gates_enforced": { "type": "boolean" },
        "closure_criteria_required": { "type": "boolean" },
        "post_incident_control_updates_required": { "type": "boolean" },
        "immutable_plan_required": { "type": "boolean" },
        "raw_payloads_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "operator_identity_included",
        "auditor_identity_included",
        "approver_identity_included",
        "ip_address_included",
        "download_urls_included",
        "raw_report_content_included",
        "provider_response_included",
        "customer_records_included",
        "private_remediation_details_included",
        "tenant_drilldown_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "operator_identity_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "provider_response_included": { "const": false },
        "customer_records_included": { "const": false },
        "private_remediation_details_included": { "const": false },
        "tenant_drilldown_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "const": "remediation_metadata_only" }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "remediation_workflow",
        "task_store",
        "approval_workflow",
        "owner_resolution",
        "control_update_workflow",
        "notification_workflow",
        "immutable_plan_store",
        "license_enforcement"
      ],
      "properties": {
        "remediation_workflow": { "const": "requires_cavra_enterprise" },
        "task_store": { "const": "requires_cavra_enterprise" },
        "approval_workflow": { "const": "requires_cavra_enterprise" },
        "owner_resolution": { "const": "requires_cavra_enterprise" },
        "control_update_workflow": { "const": "requires_cavra_enterprise" },
        "notification_workflow": { "const": "requires_cavra_enterprise" },
        "immutable_plan_store": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
