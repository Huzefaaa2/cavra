{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Approval Decision Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "approval_request",
    "decision",
    "subject",
    "policy_context",
    "evidence",
    "audit",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_approval_decision.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "approval_request": {
      "type": "object",
      "required": [
        "approval_ref",
        "request_type",
        "requested_by",
        "requested_at",
        "resource_ref",
        "risk_level",
        "reason_code"
      ],
      "properties": {
        "approval_ref": { "type": "string", "minLength": 1 },
        "request_type": {
          "enum": [
            "report_send",
            "schedule_change",
            "new_recipient_domain",
            "external_delivery_exception",
            "recipient_group_change"
          ]
        },
        "requested_by": { "type": "string", "minLength": 1 },
        "requested_at": { "type": "string", "format": "date-time" },
        "resource_ref": { "type": "string", "minLength": 1 },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["decision_ref", "decision", "decided_by", "decided_at", "expires_at", "conditions"],
      "properties": {
        "decision_ref": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "rejected", "needs_more_info", "expired", "revoked"] },
        "decided_by": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["report_ids", "formats", "delivery_mode", "recipient_scope", "recipient_addresses_redacted"],
      "properties": {
        "report_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": ["markdown", "json", "csv", "pdf", "xlsx", "docx", "html", "jsonl", "zip"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "delivery_mode": {
          "enum": ["download", "smtp", "microsoft365", "google_workspace", "ses", "sendgrid", "webhook"]
        },
        "recipient_scope": {
          "enum": ["approved_internal_domain", "approved_external_domain", "system_connector"]
        },
        "recipient_addresses_redacted": { "const": true }
      },
      "additionalProperties": false
    },
    "policy_context": {
      "type": "object",
      "required": ["recipient_policy_ref", "schedule_ref", "domain_rule_ref", "approval_policy_ref"],
      "properties": {
        "recipient_policy_ref": { "type": "string", "minLength": 1 },
        "schedule_ref": { "type": "string", "minLength": 1 },
        "domain_rule_ref": { "type": "string", "minLength": 1 },
        "approval_policy_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "approval_evidence_refs",
        "request_digest_ref",
        "decision_digest_ref",
        "immutable_store_ref"
      ],
      "properties": {
        "approval_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "request_digest_ref": { "type": "string", "minLength": 1 },
        "decision_digest_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["audit_event_ref", "logged_at", "review_required_by"],
      "properties": {
        "audit_event_ref": { "type": "string", "minLength": 1 },
        "logged_at": { "type": "string", "format": "date-time" },
        "review_required_by": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "approver_identity_included",
        "recipient_addresses_included",
        "raw_report_content_included",
        "private_justification_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "approver_identity_included": { "const": false },
        "recipient_addresses_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "private_justification_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "enum": ["metadata_only", "redacted_summary", "private_payload_ref"] }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "approval_workflow",
        "approver_identity_resolution",
        "policy_exception_store",
        "immutable_decision_audit",
        "notification_delivery",
        "license_enforcement"
      ],
      "properties": {
        "approval_workflow": { "const": "requires_cavra_enterprise" },
        "approver_identity_resolution": { "const": "requires_cavra_enterprise" },
        "policy_exception_store": { "const": "requires_cavra_enterprise" },
        "immutable_decision_audit": { "const": "requires_cavra_enterprise" },
        "notification_delivery": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
