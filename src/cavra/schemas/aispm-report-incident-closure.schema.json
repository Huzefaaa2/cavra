{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Incident Closure Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "incident",
    "remediation",
    "closure_approval",
    "lessons_learned",
    "follow_up_tasks",
    "evidence",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_incident_closure.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "incident": {
      "type": "object",
      "required": ["incident_ref", "incident_type", "severity", "final_status", "opened_at", "closed_at"],
      "properties": {
        "incident_ref": { "type": "string", "minLength": 1 },
        "incident_type": {
          "enum": [
            "evidence_room_access_review",
            "unauthorized_report_access",
            "failed_delivery_review",
            "policy_exception_review",
            "retention_violation_review",
            "watermark_failure_review"
          ]
        },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "final_status": { "enum": ["closed", "false_positive", "risk_accepted", "transferred"] },
        "opened_at": { "type": "string", "format": "date-time" },
        "closed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "required": ["summary", "actions"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action_ref", "action_type", "status", "evidence_ref"],
            "properties": {
              "action_ref": { "type": "string", "minLength": 1 },
              "action_type": {
                "enum": [
                  "access_scope_review",
                  "recipient_policy_updated",
                  "exception_expiry_confirmed",
                  "artifact_revoked",
                  "watermark_verified",
                  "delivery_route_disabled"
                ]
              },
              "status": { "enum": ["planned", "in_progress", "completed", "not_required"] },
              "evidence_ref": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "closure_approval": {
      "type": "object",
      "required": ["approval_ref", "decision", "approver_role", "decided_at", "conditions"],
      "properties": {
        "approval_ref": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "rejected", "needs_more_evidence"] },
        "approver_role": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "lessons_learned": {
      "type": "object",
      "required": ["summary", "control_updates", "runbook_refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "control_updates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "runbook_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "follow_up_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_ref", "owner_ref", "due_at", "status", "evidence_required"],
        "properties": {
          "task_ref": { "type": "string", "minLength": 1 },
          "owner_ref": { "type": "string", "minLength": 1 },
          "due_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["open", "in_progress", "completed", "cancelled"] },
          "evidence_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "closure_digest_ref",
        "incident_packet_ref",
        "closure_manifest_ref",
        "immutable_store_ref",
        "evidence_refs"
      ],
      "properties": {
        "closure_digest_ref": { "type": "string", "minLength": 1 },
        "incident_packet_ref": { "type": "string", "minLength": 1 },
        "closure_manifest_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "closure_approval_required",
        "remediation_evidence_required",
        "lessons_learned_required",
        "follow_up_tracking_required",
        "immutable_closure_required"
      ],
      "properties": {
        "closure_approval_required": { "type": "boolean" },
        "remediation_evidence_required": { "type": "boolean" },
        "lessons_learned_required": { "type": "boolean" },
        "follow_up_tracking_required": { "type": "boolean" },
        "immutable_closure_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "auditor_identity_included",
        "approver_identity_included",
        "ip_address_included",
        "download_urls_included",
        "raw_report_content_included",
        "private_justification_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "private_justification_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "const": "metadata_only" }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "closure_workflow",
        "remediation_tracking",
        "approval_identity_resolution",
        "lessons_learned_workflow",
        "immutable_closure_store",
        "license_enforcement"
      ],
      "properties": {
        "closure_workflow": { "const": "requires_cavra_enterprise" },
        "remediation_tracking": { "const": "requires_cavra_enterprise" },
        "approval_identity_resolution": { "const": "requires_cavra_enterprise" },
        "lessons_learned_workflow": { "const": "requires_cavra_enterprise" },
        "immutable_closure_store": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
