{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Pre-Action Risk Forecasts",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "mode",
    "data_provenance",
    "summary",
    "items",
    "redaction",
    "enterprise_unlocks"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.pre_action_risk_forecasts.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "community" },
    "mode": { "const": "local_activity" },
    "data_provenance": { "enum": ["local_activity_store", "sample_data"] },
    "tracking": { "const": "none" },
    "telemetry": { "const": "disabled" },
    "generated_at": { "type": "string" },
    "filters": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["total_forecasts", "critical_or_high_forecasts", "approval_recommended", "block_recommended"],
      "properties": {
        "total_forecasts": { "type": "integer", "minimum": 0 },
        "critical_or_high_forecasts": { "type": "integer", "minimum": 0 },
        "approval_recommended": { "type": "integer", "minimum": 0 },
        "block_recommended": { "type": "integer", "minimum": 0 },
        "warn_recommended": { "type": "integer", "minimum": 0 },
        "evidence_confidence": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "forecast_id",
          "decision_id",
          "agent_id",
          "action_type",
          "target_summary",
          "target_redacted",
          "forecast_status",
          "projected_blast_radius",
          "likely_impacts",
          "pre_action_controls",
          "confidence"
        ],
        "properties": {
          "forecast_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "session_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repository": { "type": "string" },
          "policy_pack": { "type": "string" },
          "rule_id": { "type": "string" },
          "action_type": { "type": "string" },
          "target_summary": { "type": "string" },
          "target_redacted": { "type": "boolean" },
          "decision": { "type": "string" },
          "severity": { "type": "string" },
          "risk_classification": { "type": "string" },
          "control_surface": { "type": "string" },
          "forecast_status": {
            "enum": ["block_recommended", "approval_recommended", "warn_recommended", "monitor"]
          },
          "projected_blast_radius": { "type": "string" },
          "likely_impacts": { "type": "array", "items": { "type": "string" } },
          "pre_action_controls": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "redaction": { "type": "object" },
    "enterprise_unlocks": { "type": "object" }
  }
}
