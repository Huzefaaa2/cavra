{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Evidence Confidence Drilldown",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "mode",
    "data_provenance",
    "summary",
    "facts",
    "redaction",
    "enterprise_unlocks"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.evidence_confidence.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "community" },
    "mode": { "const": "local_activity" },
    "data_provenance": { "enum": ["local_activity_store", "sample_data"] },
    "tracking": { "const": "none" },
    "telemetry": { "const": "disabled" },
    "generated_at": { "type": "string" },
    "filters": { "type": "object" },
    "summary": {
      "type": "object",
      "required": [
        "total_facts",
        "signed_evidence_items",
        "activity_evidence_items",
        "sample_evidence_items",
        "metadata_only_items",
        "missing_evidence_items",
        "evidence_score",
        "lowest_confidence_level",
        "highest_confidence_level"
      ],
      "properties": {
        "total_facts": { "type": "integer", "minimum": 0 },
        "signed_evidence_items": { "type": "integer", "minimum": 0 },
        "activity_evidence_items": { "type": "integer", "minimum": 0 },
        "sample_evidence_items": { "type": "integer", "minimum": 0 },
        "metadata_only_items": { "type": "integer", "minimum": 0 },
        "missing_evidence_items": { "type": "integer", "minimum": 0 },
        "evidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "lowest_confidence_level": { "type": "string" },
        "highest_confidence_level": { "type": "string" }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "fact_type",
          "source_id",
          "agent_id",
          "repository",
          "confidence_level",
          "confidence_score",
          "evidence_count",
          "signed_evidence_count",
          "evidence_refs",
          "metadata_fields",
          "recommended_action"
        ],
        "properties": {
          "fact_id": { "type": "string" },
          "fact_type": { "enum": ["policy_decision", "agent_session"] },
          "source_id": { "type": "string" },
          "session_id": { "type": ["string", "null"] },
          "agent_id": { "type": "string" },
          "repository": { "type": "string" },
          "policy_pack": { "type": "string" },
          "control_surface": { "type": "string" },
          "decision": { "type": "string" },
          "severity": { "type": "string" },
          "confidence_level": {
            "enum": [
              "signed_evidence",
              "activity_evidence_refs",
              "sample_evidence_refs",
              "activity_metadata_only",
              "missing_evidence"
            ]
          },
          "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "signed_evidence_count": { "type": "integer", "minimum": 0 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "metadata_fields": { "type": "array", "items": { "type": "string" } },
          "recommended_action": { "type": "string" },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "redaction": { "type": "object" },
    "enterprise_unlocks": { "type": "object" }
  }
}
