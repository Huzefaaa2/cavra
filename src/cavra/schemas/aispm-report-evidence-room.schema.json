{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Evidence Room Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "room",
    "access_scope",
    "artifacts",
    "controls",
    "access_log",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_evidence_room.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "room": {
      "type": "object",
      "required": ["room_ref", "title", "purpose", "status", "created_by", "created_at", "expires_at"],
      "properties": {
        "room_ref": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "active", "expired", "revoked", "closed"] },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "access_scope": {
      "type": "object",
      "required": [
        "audience",
        "recipient_scope",
        "allowed_domain_refs",
        "rbac_scope",
        "mfa_required",
        "download_allowed"
      ],
      "properties": {
        "audience": { "enum": ["external_auditor", "internal_audit", "board", "grc", "regulator"] },
        "recipient_scope": {
          "enum": ["approved_internal_domain", "approved_external_domain", "system_connector"]
        },
        "allowed_domain_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "rbac_scope": { "type": "string", "minLength": 1 },
        "mfa_required": { "type": "boolean" },
        "download_allowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "report_id",
          "format",
          "manifest_ref",
          "digest_ref",
          "watermark_required"
        ],
        "properties": {
          "artifact_ref": { "type": "string", "minLength": 1 },
          "report_id": { "type": "string", "minLength": 1 },
          "format": {
            "enum": ["markdown", "json", "csv", "pdf", "xlsx", "docx", "html", "jsonl", "zip"]
          },
          "manifest_ref": { "type": "string", "minLength": 1 },
          "digest_ref": { "type": "string", "minLength": 1 },
          "watermark_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "signed_manifest_required",
        "time_limited_links",
        "access_log_required",
        "download_watermark_required",
        "revocation_supported"
      ],
      "properties": {
        "signed_manifest_required": { "type": "boolean" },
        "time_limited_links": { "type": "boolean" },
        "access_log_required": { "type": "boolean" },
        "download_watermark_required": { "type": "boolean" },
        "revocation_supported": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "access_log": {
      "type": "object",
      "required": ["access_log_ref", "last_accessed_at", "access_count", "immutable_store_ref", "evidence_refs"],
      "properties": {
        "access_log_ref": { "type": "string", "minLength": 1 },
        "last_accessed_at": { "type": ["string", "null"], "format": "date-time" },
        "access_count": { "type": "integer", "minimum": 0 },
        "immutable_store_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "auditor_identity_included",
        "raw_report_content_included",
        "download_urls_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "download_urls_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "enum": ["metadata_only", "redacted_summary", "private_payload_ref"] }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "evidence_room_portal",
        "auditor_identity_resolution",
        "signed_download_links",
        "watermarking_service",
        "immutable_access_log",
        "license_enforcement"
      ],
      "properties": {
        "evidence_room_portal": { "const": "requires_cavra_enterprise" },
        "auditor_identity_resolution": { "const": "requires_cavra_enterprise" },
        "signed_download_links": { "const": "requires_cavra_enterprise" },
        "watermarking_service": { "const": "requires_cavra_enterprise" },
        "immutable_access_log": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
