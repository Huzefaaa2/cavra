{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Replay To Policy Review Packet",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "mode",
    "data_provenance",
    "source",
    "review_summary",
    "review_checklist",
    "policy_draft",
    "test_fixture",
    "export",
    "redaction"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.replay_to_policy_review_packet.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "community" },
    "mode": { "const": "review_packet_export" },
    "tracking": { "const": "none" },
    "telemetry": { "const": "disabled" },
    "generated_at": { "type": "string" },
    "data_provenance": {
      "type": "object",
      "required": ["draft", "tests"],
      "properties": {
        "draft": { "enum": ["local_activity_store", "sample_data"] },
        "tests": { "enum": ["local_activity_store", "sample_data"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["session_id", "draft_schema_version", "test_schema_version"],
      "properties": {
        "session_id": { "type": ["string", "null"] },
        "draft_schema_version": { "const": "cavra.aispm.replay_to_policy_draft.v1" },
        "test_schema_version": { "const": "cavra.aispm.replay_to_policy_tests.v1" }
      }
    },
    "review_summary": {
      "type": "object",
      "required": [
        "status",
        "checks_passed",
        "checks_total",
        "ci_adoption",
        "approval_required"
      ],
      "properties": {
        "status": { "type": "string" },
        "checks_passed": { "type": "integer", "minimum": 0 },
        "checks_total": { "type": "integer", "minimum": 0 },
        "ci_adoption": { "const": "requires_human_review" },
        "approval_required": { "const": true }
      }
    },
    "review_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "status", "detail"],
        "properties": {
          "label": { "type": "string" },
          "status": { "enum": ["pass", "review_required", "not_ready"] },
          "detail": { "type": "string" }
        }
      }
    },
    "policy_draft": { "type": "object" },
    "test_fixture": {
      "type": "object",
      "required": ["schema_version", "policy_id", "source_scope", "case_count", "cases", "validation"],
      "properties": {
        "schema_version": { "const": "cavra.policy_tests.replay_to_policy.v1" },
        "policy_id": { "type": "string" },
        "source_scope": { "type": "string" },
        "case_count": { "type": "integer", "minimum": 0 },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "description", "input", "expected", "assertion_type", "public_safe"],
            "properties": {
              "case_id": { "type": "string" },
              "recommendation_id": { "type": ["string", "null"] },
              "decision_id": { "type": ["string", "null"] },
              "description": { "type": "string" },
              "input": { "type": "object" },
              "expected": { "type": "object" },
              "assertion_type": { "type": "string" },
              "public_safe": { "const": true },
              "evidence_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "validation": { "type": "object" }
      }
    },
    "export": {
      "type": "object",
      "required": ["status", "filename", "intended_use"],
      "properties": {
        "status": { "const": "review_only_packet" },
        "filename": { "const": "cavra-replay-policy-review-packet.json" },
        "intended_use": { "type": "string" }
      }
    },
    "redaction": { "type": "object" }
  }
}
