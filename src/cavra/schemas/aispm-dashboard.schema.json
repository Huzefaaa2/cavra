{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AI Security Posture Dashboard",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "mode",
    "data_provenance",
    "overview",
    "agents",
    "findings",
    "timeline",
    "control_coverage",
    "control_coverage_heatmap",
    "near_misses",
    "behavior_fingerprints",
    "policy_context_gaps",
    "pre_action_risk_forecasts",
    "intent_action_drift",
    "tool_chain_graph",
    "agent_blast_radius",
    "control_plane"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.dashboard.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "enum": ["community", "enterprise"] },
    "mode": { "enum": ["local_activity", "sample", "live_enterprise"] },
    "data_provenance": {
      "enum": ["local_activity_store", "sample_data", "enterprise_live_ingestion"]
    },
    "overview": {
      "type": "object",
      "required": ["posture_score", "risk_level", "total_sessions", "total_decisions"],
      "properties": {
        "posture_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "total_sessions": { "type": "integer", "minimum": 0 },
        "total_decisions": { "type": "integer", "minimum": 0 },
        "blocked_actions": { "type": "integer", "minimum": 0 },
        "approval_required_actions": { "type": "integer", "minimum": 0 },
        "risk_findings": { "type": "integer", "minimum": 0 },
        "evidence_confidence": { "type": "string" }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id", "session_count", "decision_count", "coverage_status"],
        "properties": {
          "agent_id": { "type": "string" },
          "session_count": { "type": "integer", "minimum": 0 },
          "decision_count": { "type": "integer", "minimum": 0 },
          "coverage_status": { "type": "string" },
          "drift_status": { "type": "string" }
        }
      }
    },
    "findings": { "type": "array" },
    "timeline": { "type": "array" },
    "control_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_id", "label", "coverage_status", "decision_count", "evidence_confidence"],
        "properties": {
          "surface_id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "coverage_status": {
            "enum": [
              "not_observed_locally",
              "enforced",
              "approval_gated",
              "warning_only",
              "attested",
              "observed"
            ]
          },
          "decision_count": { "type": "integer", "minimum": 0 },
          "blocked_actions": { "type": "integer", "minimum": 0 },
          "approval_required_actions": { "type": "integer", "minimum": 0 },
          "warned_actions": { "type": "integer", "minimum": 0 },
          "evidence_confidence": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "control_coverage_heatmap": {
      "type": "object",
      "required": ["surfaces", "rows", "top_gaps", "coverage_score"],
      "properties": {
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["surface_id", "label", "description"],
            "properties": {
              "surface_id": { "type": "string" },
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["row_id", "agent_id", "repository", "cells"],
            "properties": {
              "row_id": { "type": "string" },
              "agent_id": { "type": "string" },
              "repository": { "type": "string" },
              "policy_packs": { "type": "array", "items": { "type": "string" } },
              "decision_count": { "type": "integer", "minimum": 0 },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["surface_id", "label", "coverage_status", "coverage_score", "decision_count", "recommended_action"],
                  "properties": {
                    "surface_id": { "type": "string" },
                    "label": { "type": "string" },
                    "coverage_status": { "type": "string" },
                    "coverage_score": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "decision_count": { "type": "integer", "minimum": 0 },
                    "blocked_actions": { "type": "integer", "minimum": 0 },
                    "approval_required_actions": { "type": "integer", "minimum": 0 },
                    "warned_actions": { "type": "integer", "minimum": 0 },
                    "evidence_confidence": { "type": "string" },
                    "evidence_refs": { "type": "array", "items": { "type": "string" } },
                    "recommended_action": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "top_gaps": { "type": "array" },
        "coverage_score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "near_misses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["near_miss_id", "decision_id", "agent_id", "decision", "operator_signal"],
        "properties": {
          "near_miss_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "session_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repository": { "type": "string" },
          "surface_id": { "type": "string" },
          "severity": { "type": "string" },
          "decision": { "type": "string" },
          "risk_classification": { "type": "string" },
          "reason": { "type": "string" },
          "operator_signal": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "timestamp": { "type": "string" }
        }
      }
    },
    "behavior_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint_id",
          "agent_id",
          "decision_count",
          "action_profile",
          "decision_profile",
          "risk_signals",
          "drift_status",
          "drift_score"
        ],
        "properties": {
          "fingerprint_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repositories": { "type": "array", "items": { "type": "string" } },
          "session_count": { "type": "integer", "minimum": 0 },
          "decision_count": { "type": "integer", "minimum": 0 },
          "action_profile": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "count"],
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "decision_profile": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "count"],
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "policy_packs": { "type": "array", "items": { "type": "string" } },
          "control_surfaces": { "type": "array", "items": { "type": "string" } },
          "risk_signals": { "type": "array", "items": { "type": "string" } },
          "drift_status": { "enum": ["baseline", "unusual_behavior", "review_required"] },
          "drift_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "last_seen_at": { "type": ["string", "null"] }
        }
      }
    },
    "policy_context_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "decision_id",
          "agent_id",
          "missing_context",
          "gap_status",
          "recommended_action"
        ],
        "properties": {
          "gap_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "session_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repository": { "type": "string" },
          "policy_pack": { "type": "string" },
          "rule_id": { "type": "string" },
          "action_type": { "type": "string" },
          "decision": { "type": "string" },
          "severity": { "type": "string" },
          "risk_classification": { "type": "string" },
          "control_surface": { "type": "string" },
          "missing_context": { "type": "array", "items": { "type": "string" } },
          "present_context": { "type": "array", "items": { "type": "string" } },
          "gap_status": { "enum": ["requires_context_review", "monitor"] },
          "recommended_action": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "pre_action_risk_forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "forecast_id",
          "decision_id",
          "agent_id",
          "forecast_status",
          "projected_blast_radius",
          "likely_impacts",
          "pre_action_controls"
        ],
        "properties": {
          "forecast_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "session_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repository": { "type": "string" },
          "policy_pack": { "type": "string" },
          "rule_id": { "type": "string" },
          "action_type": { "type": "string" },
          "target_summary": { "type": "string" },
          "target_redacted": { "type": "boolean" },
          "decision": { "type": "string" },
          "severity": { "type": "string" },
          "risk_classification": { "type": "string" },
          "control_surface": { "type": "string" },
          "forecast_status": {
            "enum": ["block_recommended", "approval_recommended", "warn_recommended", "monitor"]
          },
          "projected_blast_radius": { "type": "string" },
          "likely_impacts": { "type": "array", "items": { "type": "string" } },
          "pre_action_controls": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "intent_action_drift": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "drift_id",
          "decision_id",
          "agent_id",
          "declared_intent",
          "drift_status",
          "drift_score",
          "drift_signals",
          "recommended_action"
        ],
        "properties": {
          "drift_id": { "type": "string" },
          "decision_id": { "type": "string" },
          "session_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repository": { "type": "string" },
          "policy_pack": { "type": "string" },
          "rule_id": { "type": "string" },
          "declared_intent": { "type": "string" },
          "action_type": { "type": "string" },
          "target_summary": { "type": "string" },
          "target_redacted": { "type": "boolean" },
          "decision": { "type": "string" },
          "severity": { "type": "string" },
          "risk_classification": { "type": "string" },
          "control_surface": { "type": "string" },
          "drift_status": { "enum": ["aligned", "needs_review", "high_drift", "unknown_intent"] },
          "drift_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "drift_signals": { "type": "array", "items": { "type": "string" } },
          "recommended_action": { "type": "string" },
          "confidence": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "tool_chain_graph": {
      "type": "object",
      "required": ["nodes", "edges", "hotspots"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "node_type", "label", "risk_band", "risk_score", "decision_count"],
            "properties": {
              "node_id": { "type": "string" },
              "node_type": { "enum": ["agent", "tool", "target", "policy"] },
              "label": { "type": "string" },
              "risk_band": { "type": "string" },
              "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "decision_count": { "type": "integer", "minimum": 0 },
              "metadata": { "type": "object" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["edge_id", "source", "target", "relationship", "decision_id", "risk_score", "risk_band"],
            "properties": {
              "edge_id": { "type": "string" },
              "source": { "type": "string" },
              "target": { "type": "string" },
              "relationship": { "enum": ["invoked_tool", "requested_target", "governed_tool"] },
              "decision_id": { "type": "string" },
              "session_id": { "type": "string" },
              "agent_id": { "type": "string" },
              "repository": { "type": "string" },
              "action_type": { "type": "string" },
              "decision": { "type": "string" },
              "severity": { "type": "string" },
              "risk_classification": { "type": "string" },
              "control_surface": { "type": "string" },
              "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "risk_band": { "enum": ["low", "medium", "high", "critical"] },
              "target_redacted": { "type": "boolean" },
              "evidence_refs": { "type": "array", "items": { "type": "string" } },
              "timestamp": { "type": ["string", "null"] }
            }
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hotspot_id", "agent_id", "repository", "decision_count", "risk_score", "risk_band"],
            "properties": {
              "hotspot_id": { "type": "string" },
              "agent_id": { "type": "string" },
              "repository": { "type": "string" },
              "decision_count": { "type": "integer", "minimum": 0 },
              "blocked_edges": { "type": "integer", "minimum": 0 },
              "approval_required_edges": { "type": "integer", "minimum": 0 },
              "warned_edges": { "type": "integer", "minimum": 0 },
              "dominant_surface": { "type": "string" },
              "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "risk_band": { "enum": ["low", "medium", "high", "critical"] },
              "evidence_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "agent_blast_radius": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "blast_radius_level",
          "blast_radius_score",
          "repository_count",
          "repositories",
          "control_surfaces",
          "policy_packs",
          "tool_labels",
          "target_classes",
          "decision_count",
          "recommended_controls"
        ],
        "properties": {
          "agent_id": { "type": "string" },
          "blast_radius_level": { "enum": ["low", "medium", "high", "critical"] },
          "blast_radius_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "repository_count": { "type": "integer", "minimum": 0 },
          "repositories": { "type": "array", "items": { "type": "string" } },
          "control_surfaces": { "type": "array", "items": { "type": "string" } },
          "policy_packs": { "type": "array", "items": { "type": "string" } },
          "tool_labels": { "type": "array", "items": { "type": "string" } },
          "target_classes": { "type": "array", "items": { "type": "string" } },
          "sensitive_target_count": { "type": "integer", "minimum": 0 },
          "production_infrastructure_count": { "type": "integer", "minimum": 0 },
          "approval_paths": { "type": "array", "items": { "type": "string" } },
          "decision_count": { "type": "integer", "minimum": 0 },
          "session_count": { "type": "integer", "minimum": 0 },
          "blocked_actions": { "type": "integer", "minimum": 0 },
          "approval_required_actions": { "type": "integer", "minimum": 0 },
          "warned_actions": { "type": "integer", "minimum": 0 },
          "top_risks": { "type": "array", "items": { "type": "string" } },
          "recommended_controls": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "last_seen_at": { "type": ["string", "null"] }
        }
      }
    },
    "control_plane": { "type": "object" }
  }
}
