{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Exception Lifecycle Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "exception",
    "scope",
    "lifecycle_events",
    "review_policy",
    "renewal",
    "closure",
    "evidence",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_exception_lifecycle.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "exception": {
      "type": "object",
      "required": [
        "exception_ref",
        "exception_type",
        "status",
        "opened_at",
        "expires_at",
        "owner_ref",
        "linked_approval_ref"
      ],
      "properties": {
        "exception_ref": { "type": "string", "minLength": 1 },
        "exception_type": {
          "enum": [
            "external_delivery_exception",
            "recipient_domain_exception",
            "schedule_blackout_exception",
            "encryption_exception",
            "retention_exception"
          ]
        },
        "status": {
          "enum": ["active", "expiring", "expired", "revoked", "renewed", "closed"]
        },
        "opened_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "owner_ref": { "type": "string", "minLength": 1 },
        "linked_approval_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["report_ids", "recipient_scope", "domain_rule_ref", "schedule_ref", "delivery_modes"],
      "properties": {
        "report_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "recipient_scope": {
          "enum": ["approved_internal_domain", "approved_external_domain", "system_connector"]
        },
        "domain_rule_ref": { "type": "string", "minLength": 1 },
        "schedule_ref": { "type": "string", "minLength": 1 },
        "delivery_modes": {
          "type": "array",
          "items": {
            "enum": ["download", "smtp", "microsoft365", "google_workspace", "ses", "sendgrid", "webhook"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "lifecycle_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_ref", "event_type", "occurred_at", "actor_ref", "evidence_ref"],
        "properties": {
          "event_ref": { "type": "string", "minLength": 1 },
          "event_type": {
            "enum": [
              "opened",
              "review_scheduled",
              "review_completed",
              "renewed",
              "expired",
              "revoked",
              "closed"
            ]
          },
          "occurred_at": { "type": "string", "format": "date-time" },
          "actor_ref": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "review_policy": {
      "type": "object",
      "required": [
        "review_required",
        "review_due_at",
        "renewal_requires_approval",
        "revocation_requires_reason",
        "closure_requires_evidence"
      ],
      "properties": {
        "review_required": { "type": "boolean" },
        "review_due_at": { "type": ["string", "null"], "format": "date-time" },
        "renewal_requires_approval": { "type": "boolean" },
        "revocation_requires_reason": { "type": "boolean" },
        "closure_requires_evidence": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "renewal": {
      "type": "object",
      "required": [
        "renewal_allowed",
        "max_renewals",
        "renewal_window_starts_at",
        "renewal_approval_ref"
      ],
      "properties": {
        "renewal_allowed": { "type": "boolean" },
        "max_renewals": { "type": "integer", "minimum": 0 },
        "renewal_window_starts_at": { "type": ["string", "null"], "format": "date-time" },
        "renewal_approval_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": ["closure_state", "closed_at", "closure_reason", "closure_evidence_refs"],
      "properties": {
        "closure_state": { "enum": ["not_closed", "closed", "revoked", "expired"] },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "closure_reason": { "type": ["string", "null"] },
        "closure_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "exception_digest_ref",
        "lifecycle_audit_ref",
        "immutable_store_ref",
        "evidence_refs"
      ],
      "properties": {
        "exception_digest_ref": { "type": "string", "minLength": 1 },
        "lifecycle_audit_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "approver_identity_included",
        "private_justification_included",
        "raw_report_content_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "approver_identity_included": { "const": false },
        "private_justification_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "enum": ["metadata_only", "redacted_summary", "private_payload_ref"] }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "exception_store",
        "renewal_workflow",
        "revocation_workflow",
        "review_notification_delivery",
        "immutable_lifecycle_audit",
        "license_enforcement"
      ],
      "properties": {
        "exception_store": { "const": "requires_cavra_enterprise" },
        "renewal_workflow": { "const": "requires_cavra_enterprise" },
        "revocation_workflow": { "const": "requires_cavra_enterprise" },
        "review_notification_delivery": { "const": "requires_cavra_enterprise" },
        "immutable_lifecycle_audit": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
