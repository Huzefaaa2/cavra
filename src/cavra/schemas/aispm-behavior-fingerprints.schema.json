{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Behavior Fingerprints",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "mode",
    "data_provenance",
    "summary",
    "items",
    "redaction",
    "enterprise_unlocks"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.behavior_fingerprints.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "community" },
    "mode": { "const": "local_activity" },
    "data_provenance": { "enum": ["local_activity_store", "sample_data"] },
    "tracking": { "const": "none" },
    "telemetry": { "const": "disabled" },
    "generated_at": { "type": "string" },
    "filters": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["total_agents", "review_required", "unusual_behavior", "baseline", "evidence_confidence"],
      "properties": {
        "total_agents": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 },
        "unusual_behavior": { "type": "integer", "minimum": 0 },
        "baseline": { "type": "integer", "minimum": 0 },
        "evidence_confidence": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint_id",
          "agent_id",
          "repositories",
          "session_count",
          "decision_count",
          "action_profile",
          "decision_profile",
          "policy_packs",
          "control_surfaces",
          "risk_signals",
          "drift_status",
          "drift_score",
          "evidence_refs"
        ],
        "properties": {
          "fingerprint_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "repositories": { "type": "array", "items": { "type": "string" } },
          "session_count": { "type": "integer", "minimum": 0 },
          "decision_count": { "type": "integer", "minimum": 0 },
          "action_profile": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "count"],
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "decision_profile": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "count"],
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "policy_packs": { "type": "array", "items": { "type": "string" } },
          "control_surfaces": { "type": "array", "items": { "type": "string" } },
          "risk_signals": { "type": "array", "items": { "type": "string" } },
          "drift_status": { "enum": ["baseline", "unusual_behavior", "review_required"] },
          "drift_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "last_seen_at": { "type": ["string", "null"] }
        }
      }
    },
    "redaction": { "type": "object" },
    "enterprise_unlocks": { "type": "object" }
  }
}
