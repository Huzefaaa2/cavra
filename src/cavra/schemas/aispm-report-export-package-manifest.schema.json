{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Export Package Manifest Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "tenant_ref",
    "package",
    "artifacts",
    "delivery_targets",
    "integrity",
    "evidence",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "cavra.aispm.report_export_package_manifest.v1" },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "package": {
      "type": "object",
      "required": [
        "package_ref",
        "package_type",
        "requested_by",
        "created_at",
        "retention_class",
        "watermark_required",
        "signed_manifest_required"
      ],
      "properties": {
        "package_ref": { "type": "string", "minLength": 1 },
        "package_type": {
          "enum": [
            "board_and_audit_bundle",
            "grc_upload_package",
            "siem_export_bundle",
            "evidence_room_bundle",
            "incident_review_packet"
          ]
        },
        "requested_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "retention_class": {
          "enum": ["operational_record", "governance_record", "audit_record", "legal_hold"]
        },
        "watermark_required": { "type": "boolean" },
        "signed_manifest_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "report_id",
          "format",
          "content_ref",
          "digest_ref",
          "size_bytes"
        ],
        "properties": {
          "artifact_ref": { "type": "string", "minLength": 1 },
          "report_id": { "type": "string", "minLength": 1 },
          "format": {
            "enum": ["markdown", "json", "csv", "pdf", "xlsx", "docx", "html", "jsonl", "zip"]
          },
          "content_ref": { "type": "string", "minLength": 1 },
          "digest_ref": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "delivery_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_ref",
          "target_type",
          "recipient_scope",
          "delivery_mode",
          "approval_required"
        ],
        "properties": {
          "target_ref": { "type": "string", "minLength": 1 },
          "target_type": {
            "enum": ["download", "email", "grc_upload", "siem_export", "evidence_room"]
          },
          "recipient_scope": {
            "enum": ["approved_internal_domain", "approved_external_domain", "system_connector"]
          },
          "delivery_mode": {
            "enum": ["download", "smtp", "microsoft365", "google_workspace", "ses", "sendgrid", "webhook"]
          },
          "approval_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "required": ["manifest_digest_ref", "signature_ref", "chain_ref", "checksums_required"],
      "properties": {
        "manifest_digest_ref": { "type": "string", "minLength": 1 },
        "signature_ref": { "type": "string", "minLength": 1 },
        "chain_ref": { "type": "string", "minLength": 1 },
        "checksums_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_evidence_refs", "export_audit_ref", "immutable_store_ref"],
      "properties": {
        "source_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "export_audit_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "raw_report_content_included",
        "recipient_addresses_included",
        "download_urls_included",
        "customer_records_included",
        "secrets_included",
        "payload_handling"
      ],
      "properties": {
        "raw_report_content_included": { "const": false },
        "recipient_addresses_included": { "const": false },
        "download_urls_included": { "const": false },
        "customer_records_included": { "const": false },
        "secrets_included": { "const": false },
        "payload_handling": { "enum": ["metadata_only", "redacted_summary", "private_payload_ref"] }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "package_renderer",
        "artifact_storage",
        "manifest_signing",
        "grc_connector",
        "siem_exporter",
        "license_enforcement"
      ],
      "properties": {
        "package_renderer": { "const": "requires_cavra_enterprise" },
        "artifact_storage": { "const": "requires_cavra_enterprise" },
        "manifest_signing": { "const": "requires_cavra_enterprise" },
        "grc_connector": { "const": "requires_cavra_enterprise" },
        "siem_exporter": { "const": "requires_cavra_enterprise" },
        "license_enforcement": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
