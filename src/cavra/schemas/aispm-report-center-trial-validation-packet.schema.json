{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAVRA AISPM Report Center Enterprise Trial Validation Packet Public Contract",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "trial_ref",
    "tenant_ref",
    "validation_summary",
    "package_under_test",
    "validation_paths",
    "artifacts",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "cavra.aispm.report_center_trial_validation_packet.v1"
    },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise_trial" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "trial_ref": { "type": "string", "minLength": 1 },
    "tenant_ref": { "type": "string", "minLength": 1 },
    "validation_summary": {
      "type": "object",
      "required": [
        "status",
        "passed_paths",
        "warning_paths",
        "blocked_paths",
        "failed_paths",
        "evidence_packet_ref",
        "validated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready_for_evaluator_review",
            "needs_operator_review",
            "blocked",
            "failed"
          ]
        },
        "passed_paths": { "type": "integer", "minimum": 0 },
        "warning_paths": { "type": "integer", "minimum": 0 },
        "blocked_paths": { "type": "integer", "minimum": 0 },
        "failed_paths": { "type": "integer", "minimum": 0 },
        "evidence_packet_ref": { "type": "string", "minLength": 1 },
        "validated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "package_under_test": {
      "type": "object",
      "required": [
        "package_ref",
        "version",
        "image_ref",
        "license_status",
        "license_validation_mode",
        "source_included"
      ],
      "properties": {
        "package_ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "image_ref": { "type": "string", "minLength": 1 },
        "license_status": {
          "enum": ["trial_active", "trial_expired", "trial_revoked", "trial_invalid"]
        },
        "license_validation_mode": {
          "enum": ["hosted_validation", "offline_validation", "not_validated"]
        },
        "source_included": { "const": false }
      },
      "additionalProperties": false
    },
    "validation_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "title",
          "status",
          "assertions",
          "evidence_refs",
          "public_artifact_refs"
        ],
        "properties": {
          "path_id": {
            "enum": [
              "setup_wizard",
              "render_report",
              "send_blocked_by_policy",
              "send_after_approval",
              "schedule_run",
              "evidence_room",
              "alert_escalation",
              "remediation_closure",
              "executive_digest_distribution",
              "revocation_and_retention"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["passed", "warning", "blocked", "failed", "not_run"]
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "public_artifact_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "schemas_validated",
        "packet_digest_ref",
        "immutable_store_ref",
        "operator_dashboard_ref"
      ],
      "properties": {
        "schemas_validated": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "packet_digest_ref": { "type": "string", "minLength": 1 },
        "immutable_store_ref": { "type": "string", "minLength": 1 },
        "operator_dashboard_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "license_validated",
        "tenant_scoped",
        "approval_before_send_verified",
        "recipient_policy_verified",
        "retention_policy_verified",
        "revocation_verified",
        "immutable_evidence_required",
        "raw_payloads_excluded"
      ],
      "properties": {
        "license_validated": { "type": "boolean" },
        "tenant_scoped": { "type": "boolean" },
        "approval_before_send_verified": { "type": "boolean" },
        "recipient_policy_verified": { "type": "boolean" },
        "retention_policy_verified": { "type": "boolean" },
        "revocation_verified": { "type": "boolean" },
        "immutable_evidence_required": { "type": "boolean" },
        "raw_payloads_excluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": [
        "recipient_addresses_included",
        "operator_identity_included",
        "auditor_identity_included",
        "approver_identity_included",
        "board_member_identity_included",
        "ip_address_included",
        "download_urls_included",
        "raw_prompt_included",
        "model_reasoning_included",
        "raw_tool_output_included",
        "raw_report_content_included",
        "provider_response_included",
        "customer_records_included",
        "private_remediation_details_included",
        "tenant_drilldown_records_included",
        "secrets_included",
        "source_code_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "operator_identity_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "board_member_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "raw_prompt_included": { "const": false },
        "model_reasoning_included": { "const": false },
        "raw_tool_output_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "provider_response_included": { "const": false },
        "customer_records_included": { "const": false },
        "private_remediation_details_included": { "const": false },
        "tenant_drilldown_records_included": { "const": false },
        "secrets_included": { "const": false },
        "source_code_included": { "const": false },
        "payload_handling": {
          "const": "report_center_trial_validation_metadata_only"
        }
      },
      "additionalProperties": false
    },
    "enterprise_boundaries": {
      "type": "object",
      "required": [
        "trial_license_service",
        "report_renderer",
        "delivery_worker",
        "scheduler",
        "evidence_room_worker",
        "alert_evaluator",
        "remediation_workflow",
        "digest_distribution_worker",
        "tenant_store"
      ],
      "properties": {
        "trial_license_service": { "const": "requires_cavra_enterprise" },
        "report_renderer": { "const": "requires_cavra_enterprise" },
        "delivery_worker": { "const": "requires_cavra_enterprise" },
        "scheduler": { "const": "requires_cavra_enterprise" },
        "evidence_room_worker": { "const": "requires_cavra_enterprise" },
        "alert_evaluator": { "const": "requires_cavra_enterprise" },
        "remediation_workflow": { "const": "requires_cavra_enterprise" },
        "digest_distribution_worker": { "const": "requires_cavra_enterprise" },
        "tenant_store": { "const": "requires_cavra_enterprise" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
