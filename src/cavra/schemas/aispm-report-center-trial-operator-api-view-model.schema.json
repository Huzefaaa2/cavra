{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cavra.dev/schemas/aispm-report-center-trial-operator-api-view-model.schema.json",
  "title": "CAVRA AISPM Report Center Trial Operator API View Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "source_contract_ref",
    "api_surface",
    "view_model",
    "action_state_machine",
    "audit_events",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "cavra.aispm.report_center_trial_operator_api_view_model.v1"
    },
    "product": {
      "const": "CAVRA"
    },
    "edition": {
      "const": "enterprise_trial"
    },
    "contract_visibility": {
      "const": "public_contract"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "api_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_path", "auth_required", "auth_modes", "content_type", "endpoints"],
      "properties": {
        "base_path": {
          "type": "string",
          "pattern": "^/enterprise/trial/operator/"
        },
        "auth_required": {
          "const": true
        },
        "auth_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["github_operator_session", "enterprise_operator_sso"]
          }
        },
        "content_type": {
          "const": "application/json"
        },
        "endpoints": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endpoint_id",
              "method",
              "path",
              "purpose",
              "response_model",
              "audit_event_required"
            ],
            "properties": {
              "endpoint_id": {
                "type": "string",
                "enum": [
                  "get-dashboard",
                  "get-validation-packet",
                  "approve-handoff",
                  "request-rerun"
                ]
              },
              "method": {
                "type": "string",
                "enum": ["GET", "POST"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "response_model": {
                "type": "string",
                "enum": [
                  "trial_operator_dashboard_view",
                  "trial_validation_packet_summary",
                  "trial_operator_action_result"
                ]
              },
              "audit_event_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    "view_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "route",
        "title",
        "refresh_interval_seconds",
        "sections",
        "primary_actions",
        "filters",
        "empty_states"
      ],
      "properties": {
        "view_id": {
          "const": "trial_operator_dashboard_view"
        },
        "route": {
          "type": "string",
          "pattern": "^/operator/"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "refresh_interval_seconds": {
          "type": "integer",
          "minimum": 15
        },
        "sections": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "title", "data_source", "fields"],
            "properties": {
              "section_id": {
                "type": "string",
                "enum": [
                  "validation_rollup",
                  "path_status",
                  "approval_blockers",
                  "evidence_links",
                  "evaluator_handoff"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "data_source": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "primary_actions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_id", "label", "method", "endpoint_id", "enabled_when"],
            "properties": {
              "action_id": {
                "type": "string",
                "enum": [
                  "review-trial-validation",
                  "approve-evaluator-handoff",
                  "request-rerun"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "enum": ["GET", "POST"]
              },
              "endpoint_id": {
                "type": "string",
                "enum": [
                  "get-validation-packet",
                  "approve-handoff",
                  "request-rerun"
                ]
              },
              "enabled_when": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "filters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filter_id", "values"],
            "properties": {
              "filter_id": {
                "type": "string",
                "enum": ["path_status", "operator_state"]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "empty_states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state_id", "message"],
            "properties": {
              "state_id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "action_state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "pending_validation",
              "ready_for_operator_review",
              "handoff_approved",
              "rerun_requested",
              "blocked"
            ]
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "trigger"],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "audit_events": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_type", "required_fields"],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "operator_dashboard_viewed",
              "validation_packet_reviewed",
              "evaluator_handoff_approved",
              "validation_rerun_requested"
            ]
          },
          "required_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_auth_required",
        "rbac_required",
        "csrf_protection_required",
        "immutable_audit_required",
        "approval_before_handoff_required",
        "rate_limit_required",
        "evidence_refs_only",
        "raw_payloads_excluded"
      ],
      "properties": {
        "operator_auth_required": { "const": true },
        "rbac_required": { "const": true },
        "csrf_protection_required": { "const": true },
        "immutable_audit_required": { "const": true },
        "approval_before_handoff_required": { "const": true },
        "rate_limit_required": { "const": true },
        "evidence_refs_only": { "const": true },
        "raw_payloads_excluded": { "const": true }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_addresses_included",
        "operator_identity_included",
        "evaluator_identity_included",
        "auditor_identity_included",
        "approver_identity_included",
        "board_member_identity_included",
        "ip_address_included",
        "download_urls_included",
        "raw_prompt_included",
        "model_reasoning_included",
        "raw_tool_output_included",
        "raw_report_content_included",
        "provider_response_included",
        "customer_records_included",
        "private_remediation_details_included",
        "tenant_drilldown_records_included",
        "secrets_included",
        "source_code_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "operator_identity_included": { "const": false },
        "evaluator_identity_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "board_member_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "raw_prompt_included": { "const": false },
        "model_reasoning_included": { "const": false },
        "raw_tool_output_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "provider_response_included": { "const": false },
        "customer_records_included": { "const": false },
        "private_remediation_details_included": { "const": false },
        "tenant_drilldown_records_included": { "const": false },
        "secrets_included": { "const": false },
        "source_code_included": { "const": false },
        "payload_handling": {
          "const": "report_center_trial_operator_api_metadata_only"
        }
      }
    },
    "enterprise_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_dashboard_api",
        "operator_session_store",
        "trial_validation_store",
        "handoff_workflow",
        "package_access_service",
        "license_service",
        "support_queue",
        "audit_store"
      ],
      "properties": {
        "operator_dashboard_api": { "const": "requires_cavra_enterprise" },
        "operator_session_store": { "const": "requires_cavra_enterprise" },
        "trial_validation_store": { "const": "requires_cavra_enterprise" },
        "handoff_workflow": { "const": "requires_cavra_enterprise" },
        "package_access_service": { "const": "requires_cavra_enterprise" },
        "license_service": { "const": "requires_cavra_enterprise" },
        "support_queue": { "const": "requires_cavra_enterprise" },
        "audit_store": { "const": "requires_cavra_enterprise" }
      }
    }
  }
}
