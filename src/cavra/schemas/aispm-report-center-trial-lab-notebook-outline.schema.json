{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cavra.dev/schemas/aispm-report-center-trial-lab-notebook-outline.schema.json",
  "title": "CAVRA AISPM Report Center Trial Lab Notebook Outline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "edition",
    "contract_visibility",
    "generated_at",
    "notebook_ref",
    "source_contract_refs",
    "notebook",
    "chapters",
    "labs",
    "visual_assets",
    "verification_checkpoints",
    "role_paths",
    "publishing",
    "controls",
    "redaction",
    "enterprise_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "cavra.aispm.report_center_trial_lab_notebook_outline.v1"
    },
    "product": { "const": "CAVRA" },
    "edition": { "const": "enterprise_trial" },
    "contract_visibility": { "const": "public_contract" },
    "generated_at": { "type": "string", "format": "date-time" },
    "notebook_ref": { "type": "string", "pattern": "^wiki:" },
    "source_contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "audiences",
        "publication_target",
        "status",
        "estimated_duration_minutes",
        "requires_enterprise_trial",
        "public_safe"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "developer",
              "platform_engineer",
              "security_engineer",
              "auditor",
              "cso_ciso"
            ]
          }
        },
        "publication_target": { "const": "github_wiki" },
        "status": { "type": "string", "enum": ["outline_ready", "published", "needs_update"] },
        "estimated_duration_minutes": { "type": "integer", "minimum": 1 },
        "requires_enterprise_trial": { "const": true },
        "public_safe": { "const": true }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "title", "objective", "labs", "required_assets"],
        "properties": {
          "chapter_id": {
            "type": "string",
            "enum": [
              "orientation",
              "trial-access",
              "agent-enforcement",
              "aispm-dashboard",
              "report-center",
              "closeout"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "labs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "required_assets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lab_id",
          "title",
          "role",
          "phase",
          "expected_minutes",
          "verification_checkpoint",
          "evidence_ref"
        ],
        "properties": {
          "lab_id": { "type": "string", "pattern": "^lab-" },
          "title": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": [
              "developer",
              "platform_engineer",
              "security_engineer",
              "auditor",
              "cso_ciso"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "orientation",
              "trial-access",
              "agent-enforcement",
              "aispm-dashboard",
              "report-center",
              "closeout"
            ]
          },
          "expected_minutes": { "type": "integer", "minimum": 1 },
          "verification_checkpoint": { "type": "string", "pattern": "^checkpoint-" },
          "evidence_ref": { "type": "string", "pattern": "^cavra://evidence/redacted/" }
        }
      }
    },
    "visual_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_type", "format", "status", "public_safe"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "asset_type": {
            "type": "string",
            "enum": ["diagram", "screenshot", "flow_chart"]
          },
          "format": { "type": "string", "enum": ["png", "svg", "markdown"] },
          "status": { "type": "string", "enum": ["required", "optional", "complete"] },
          "public_safe": { "const": true }
        }
      }
    },
    "verification_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpoint_id", "expected_result", "evidence_ref"],
        "properties": {
          "checkpoint_id": { "type": "string", "pattern": "^checkpoint-" },
          "expected_result": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "pattern": "^cavra://evidence/redacted/" }
        }
      }
    },
    "role_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "recommended_labs"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "developer",
              "platform_engineer",
              "security_engineer",
              "auditor",
              "cso_ciso"
            ]
          },
          "recommended_labs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^lab-" }
          }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "page_title",
        "requires_screenshots",
        "requires_diagrams",
        "requires_flow_charts",
        "requires_checkpoint_evidence",
        "update_after_phase_completion"
      ],
      "properties": {
        "target": { "const": "github_wiki" },
        "page_title": { "type": "string", "minLength": 1 },
        "requires_screenshots": { "const": true },
        "requires_diagrams": { "const": true },
        "requires_flow_charts": { "const": true },
        "requires_checkpoint_evidence": { "const": true },
        "update_after_phase_completion": { "const": true }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_safe_required",
        "screenshots_redacted",
        "diagram_sources_public_safe",
        "checkpoint_evidence_required",
        "enterprise_source_excluded",
        "license_secret_excluded",
        "customer_data_excluded"
      ],
      "properties": {
        "public_safe_required": { "const": true },
        "screenshots_redacted": { "const": true },
        "diagram_sources_public_safe": { "const": true },
        "checkpoint_evidence_required": { "const": true },
        "enterprise_source_excluded": { "const": true },
        "license_secret_excluded": { "const": true },
        "customer_data_excluded": { "const": true }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_addresses_included",
        "operator_identity_included",
        "evaluator_identity_included",
        "auditor_identity_included",
        "approver_identity_included",
        "board_member_identity_included",
        "ip_address_included",
        "download_urls_included",
        "package_tokens_included",
        "license_key_included",
        "raw_prompt_included",
        "model_reasoning_included",
        "raw_tool_output_included",
        "raw_report_content_included",
        "provider_response_included",
        "customer_records_included",
        "private_remediation_details_included",
        "tenant_drilldown_records_included",
        "secrets_included",
        "source_code_included",
        "payload_handling"
      ],
      "properties": {
        "recipient_addresses_included": { "const": false },
        "operator_identity_included": { "const": false },
        "evaluator_identity_included": { "const": false },
        "auditor_identity_included": { "const": false },
        "approver_identity_included": { "const": false },
        "board_member_identity_included": { "const": false },
        "ip_address_included": { "const": false },
        "download_urls_included": { "const": false },
        "package_tokens_included": { "const": false },
        "license_key_included": { "const": false },
        "raw_prompt_included": { "const": false },
        "model_reasoning_included": { "const": false },
        "raw_tool_output_included": { "const": false },
        "raw_report_content_included": { "const": false },
        "provider_response_included": { "const": false },
        "customer_records_included": { "const": false },
        "private_remediation_details_included": { "const": false },
        "tenant_drilldown_records_included": { "const": false },
        "secrets_included": { "const": false },
        "source_code_included": { "const": false },
        "payload_handling": {
          "const": "report_center_trial_lab_notebook_outline_metadata_only"
        }
      }
    },
    "enterprise_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wiki_publication_workflow",
        "trial_portal",
        "license_service",
        "package_access_service",
        "private_lab_fixtures"
      ],
      "properties": {
        "wiki_publication_workflow": { "const": "public_docs_only" },
        "trial_portal": { "const": "requires_cavra_enterprise" },
        "license_service": { "const": "requires_cavra_enterprise" },
        "package_access_service": { "const": "requires_cavra_enterprise" },
        "private_lab_fixtures": { "const": "requires_cavra_enterprise" }
      }
    }
  }
}
