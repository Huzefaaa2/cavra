{
  "auth": {
    "modes": [
      "bearer_token",
      "api_key"
    ],
    "secret_fields": [
      "authorization",
      "token",
      "api_key",
      "webhook_url",
      "client_secret"
    ]
  },
  "capabilities": [
    "change_request",
    "incident_creation",
    "correlation_id",
    "audit_metadata"
  ],
  "category": "itsm",
  "certification_tier": "certified",
  "compatibility": {
    "api_contract": "openapi/cavra-api.openapi.json",
    "cavra_versions": [
      "1.0.0"
    ],
    "connector_sdk": "1.0"
  },
  "connector_id": "cavra-certified-servicenow",
  "display_name": "ServiceNow Connector",
  "entrypoint": "cavra.connectors.servicenow:CertifiedConnector",
  "provider": "servicenow",
  "runtime": {
    "language": "python",
    "max_retries_default": 2,
    "min_python": "3.9",
    "network_required": true,
    "timeout_seconds_default": 10
  },
  "schema_version": "cavra.connector.sdk.manifest.v1",
  "sdk_version": "1.0",
  "security": {
    "does_not_log_payload_secrets": true,
    "idempotency_supported": true,
    "redacts_secrets": true,
    "supports_retries": true,
    "supports_timeout": true,
    "tenant_scope_required": true
  },
  "supported_events": [
    "cavra.approval.required",
    "cavra.runtime.decision",
    "cavra.aispm.finding"
  ],
  "tests": {
    "fixtures": [
      "examples/connectors/priority-certified/servicenow.json"
    ],
    "suites": [
      "auth",
      "compatibility",
      "contract",
      "redaction",
      "retry",
      "timeout",
      "unit"
    ]
  },
  "version": "2026.07"
}
