{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cavra.dev/schemas/community-ga-release-packet.schema.json",
  "title": "CAVRA Community GA Release Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "release_name",
    "release_state",
    "prepared_by",
    "prepared_at",
    "repository",
    "branch",
    "pull_request",
    "commit",
    "wiki_sync_commit",
    "gates",
    "validation_commands",
    "accepted_risks",
    "public_boundary_review",
    "decision",
    "next_recommendation"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "release_name": {
      "type": "string",
      "minLength": 1
    },
    "release_state": {
      "type": "string",
      "enum": [
        "ready_for_community_ga",
        "ready_with_accepted_risk",
        "blocked"
      ]
    },
    "prepared_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string"
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "pull_request": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "tag": {
      "type": "string"
    },
    "wiki_sync_commit": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/gate_result"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation_command"
      }
    },
    "accepted_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accepted_risk"
      }
    },
    "public_boundary_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enterprise_code_present",
        "secrets_present",
        "customer_material_present",
        "private_policy_packs_present",
        "validation_result"
      ],
      "properties": {
        "enterprise_code_present": {
          "type": "boolean"
        },
        "secrets_present": {
          "type": "boolean"
        },
        "customer_material_present": {
          "type": "boolean"
        },
        "private_policy_packs_present": {
          "type": "boolean"
        },
        "validation_result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "warn"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approve",
            "block",
            "defer"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next_recommendation": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "evidence_reference",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "Public boundary",
            "Policy signing",
            "Policy validation",
            "Runtime modes",
            "Golden decisions",
            "Evidence Console",
            "Deployment validation",
            "Go runtime readiness",
            "Documentation",
            "CI evidence"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "warn",
            "disabled"
          ]
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "validation_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "warn",
            "not_run"
          ]
        },
        "output_reference": {
          "type": "string"
        }
      }
    },
    "accepted_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "severity",
        "owner",
        "expiry",
        "compensating_control",
        "decision"
      ],
      "properties": {
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expiry": {
          "type": "string",
          "format": "date"
        },
        "compensating_control": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ]
        }
      }
    }
  }
}
